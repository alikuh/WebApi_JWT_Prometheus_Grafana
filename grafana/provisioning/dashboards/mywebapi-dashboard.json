{
    "title": "MyWebApi Dashboard",
    "uid": "mywebapi-dashboard",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "İstek Hızı",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "mywebapi-prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(http_requests_received_total[1m])",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "title": "Uygulama Logları",
            "type": "logs",
            "datasource": {
                "type": "loki",
                "uid": "mywebapi-loki"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "{app=\"mywebapi\"}",
                    "refId": "A"
                }
            ]
        }
    ]
}